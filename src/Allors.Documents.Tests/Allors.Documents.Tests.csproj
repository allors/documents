<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.msbuild" Version="6.0.1">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.6.0" />
    <PackageReference Include="XMLUnit.Core" Version="2.9.2" />
    <PackageReference Include="xunit" Version="2.7.0" />
    <PackageReference Include="xunit.analyzers" Version="1.11.0" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.7">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <!-- The imaging tests decode and encode pictures; CI runs them on Linux. Same version as the imaging package's SkiaSharp. -->
    <PackageReference Include="SkiaSharp.NativeAssets.Linux" Version="4.151.5" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="Resources\1.png" />
    <None Remove="Resources\2.png" />
    <None Remove="Resources\3.png" />
    <None Remove="Resources\EmbeddedTemplate.fodt" />
    <None Remove="Resources\EmbeddedTemplate.odt" />
    <None Remove="Resources\logo.png" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\1.png" />
    <EmbeddedResource Include="Resources\2.png" />
    <EmbeddedResource Include="Resources\3.png" />
    <EmbeddedResource Include="Resources\EmbeddedTemplate.fodt" />
    <EmbeddedResource Include="Resources\EmbeddedTemplate.odt" />
    <EmbeddedResource Include="Resources\logo.png" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Allors.Documents\Allors.Documents.csproj" />
    <ProjectReference Include="..\Allors.Documents.Barcodes\Allors.Documents.Barcodes.csproj" />
    <ProjectReference Include="..\Allors.Documents.Imaging\Allors.Documents.Imaging.csproj" />
    <ProjectReference Include="..\Allors.Documents.Reflection\Allors.Documents.Reflection.csproj" />
  </ItemGroup>
</Project>
